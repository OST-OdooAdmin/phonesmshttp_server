<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (Odoo 18/19 <list> tag) -->
    <record id="view_studio_custom_app_tree" model="ir.ui.view">
        <field name="name">studio.custom.app.list</field>
        <field name="model">studio.custom.app</field>
        <field name="arch" type="xml">
            <list string="AI Studio Apps">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="model_name"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <!-- Clean Form View with Jemi AI Assistant -->
    <record id="view_studio_custom_app_form" model="ir.ui.view">
        <field name="name">studio.custom.app.form</field>
        <field name="model">studio.custom.app</field>
        <field name="arch" type="xml">
            <form string="AI Studio App Builder">
                <header>
                    <button name="action_start_jemi_guided_chat" type="object" string="🤖 Start Guided Chat with Jemi" class="btn-info" invisible="state == 'generated'"/>
                    <button name="action_generate_app" type="object" string="🚀 Generate &amp; Build App via Gemini AI" class="btn-primary" invisible="state == 'generated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="App Title / Name"/>
                        <h1><field name="name" placeholder="e.g. Field Service Dispatcher"/></h1>
                    </div>
                    <group>
                        <group string="Technical Identifiers">
                            <field name="technical_name" placeholder="e.g. field_service_sms"/>
                            <field name="model_name" placeholder="e.g. x_field.service"/>
                        </group>
                        <group string="AI Description / Prompt">
                            <field name="description" placeholder="Describe your requirement to AI Bot Jemi..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Custom Fields (20 Field Types)">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="name" placeholder="e.g. x_technician_phone"/>
                                    <field name="field_description" placeholder="e.g. Technician Mobile"/>
                                    <field name="ttype"/>
                                </list>
                            </field>
                        </page>
                        <page string="Automations &amp; Outbound Webhooks">
                            <field name="automation_ids">
                                <list editable="bottom">
                                    <field name="name" placeholder="e.g. Trigger SMS on Dispatch"/>
                                    <field name="trigger"/>
                                    <field name="action_type"/>
                                    <field name="webhook_url" placeholder="http://115.135.158.84:2222/queue-sms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter for AI Bot Jemi -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- AI Studio Configuration Settings View (Structured into 3 Explicit Sections) -->
    <record id="res_config_settings_view_form_studio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.studio</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Odoo Studio" string="AI Studio Configuration" name="odoo_studio_builder">
                    
                    <!-- SECTION 1: FREE & UNLIMITED AI PLATFORMS -->
                    <block title="SECTION 1: FREE &amp; UNLIMITED AI PLATFORMS (NO LIMITS, ZERO RESTRICTION)">
                        <setting string="Active AI Engine Selection" help="Primary Engine: Google Antigravity Universal Engine (100% Free, Unlimited, Zero Rate Limits)">
                            <field name="ai_provider"/>
                        </setting>
                    </block>

                    <!-- SECTION 2: ENTERPRISE PAID AI PLATFORMS & ACCOUNT CREDENTIALS -->
                    <block title="SECTION 2: ENTERPRISE PAID AI PLATFORMS (CUSTOM API KEYS &amp; ACCOUNT CREDENTIALS)">
                        <setting string="Account User ID / License Key" help="Key in your registered User ID for Enterprise AI access">
                            <field name="jemi_user_id" placeholder="e.g. USER-2026-8894"/>
                        </setting>
                        <setting string="Account / Organization ID" help="Key in your registered Organization or Account ID">
                            <field name="jemi_account_id" placeholder="e.g. ORG-DREAM-7721"/>
                        </setting>
                        <setting string="Enterprise Paid API Key" help="Key in your Paid API Key for Google Gemini Pro, OpenAI GPT-4o, or Claude 3.5 Sonnet">
                            <field name="gemini_api_key" password="True"/>
                        </setting>
                    </block>

                    <!-- SECTION 3: FREE AI WITH QUOTA LIMITS (AUTO-ROTATING BACKUPS) -->
                    <block title="SECTION 3: FREE AI WITH QUOTA LIMITS (AUTO-ROTATING BACKUPS &amp; RESET WARNINGS)">
                        <setting string="Backup Auto-Rotation Rules" help="Section 3 engines auto-rotate at 50% quota capacity (15 RPM / 30 RPM limits). If exhausted, Jemi displays reset warning banner and switches to Section 1 Primary Engine.">
                            <span class="text-muted">Engines: Meta Llama 3.3 70B, Google Gemini 2.0 Flash, Google Gemini 2.0 Flash-Lite</span>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_studio_custom_app" model="ir.actions.act_window">
        <field name="name">AI Studio App Builder</field>
        <field name="res_model">studio.custom.app</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_studio_config_settings" model="ir.actions.act_window">
        <field name="name">AI Studio Configuration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'odoo_studio_builder'}</field>
    </record>

    <!-- Top Menuitems -->
    <menuitem id="menu_studio_custom_app_root" name="AI Studio" sequence="5"/>
    <menuitem id="menu_studio_custom_app_main" name="Custom Apps &amp; Modules" parent="menu_studio_custom_app_root" action="action_studio_custom_app"/>
    <menuitem id="menu_studio_config_settings" name="AI Engine &amp; Account Settings" parent="menu_studio_custom_app_root" action="action_studio_config_settings"/>
    
    <!-- Also add under Settings Technical menu for easy user access -->
    <menuitem id="menu_studio_config_settings_technical" name="AI Studio Configuration" parent="base.menu_custom" action="action_studio_config_settings"/>
</odoo>
